{
  "name": "vue-scrum-poker-tool",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "vite --host",
    "dev": "vite",
    "check-type": "vue-tsc --build --force",
    "build": "pnpm run check-type && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "check-lint": "eslint .",
    "pretty": "prettier --write \"./**/*.{js,ts,vue}\"",
    "check-pretty": "prettier --check \"./**/*.{js,ts,vue}\"",
    "test": "vitest",
    "vitest-ui": "vitest --ui --coverage.enabled=true",
    "coverage": "vitest run --coverage --watch false"
  },
  "engines": {
    "node": ">=26.12.1",
    "npm": ">=0 <0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "5.3.0",
    "@lucide/vue": "^1.74.0",
    "@mdi/font": "7.4.47",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45",
    "vuetify": "^4.3.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "deepmerge": "^4.3.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.108.2",
    "sass-embedded": "^1.108.2",
    "sass-loader": "^17.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "5.0.5",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.21.0"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
